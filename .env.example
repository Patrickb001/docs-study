# Settings for Docs Study.
# Copy this file to .env, then fill in what you need:
#   macOS or Linux:  cp .env.example .env
#   Windows:         copy .env.example .env
# Keep .env private. Git ignores it, so it is never committed.
# Restart the app after you change anything here.

# Your Claude API key, from https://console.anthropic.com/
# Without it the sample library still works, but you cannot import your own docs,
# and written answers are not marked for you.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Everything below is optional. The value shown is the default.
# Remove the # at the start of a line to change it.
# ---------------------------------------------------------------------------

# The most an import or update may cost, in US dollars.
# The app refuses anything whose estimate is above this.
# SPEND_LIMIT_USD=10

# The port the local server listens on.
# If you change it, also set VITE_API_URL in web/.env (see the bottom of this file).
# PORT=4000

# Where your study progress is kept, relative to the project folder.
# DB_FILE=data/docs-study.db

# A GitHub personal access token. It raises GitHub's request limit
# when you import a GitHub folder. Leave it out for small imports.
# GITHUB_TOKEN=

# The Claude models. The writer makes questions and exercises. The grader marks written answers.
# WRITER_MODEL=claude-sonnet-5-5
# GRADER_MODEL=claude-haiku-4-5-20251001

# How hard the writer model thinks: low, medium or high. Lower is cheaper.
# If you set it to nothing (WRITER_EFFORT=), the model's own default is used.
# WRITER_EFFORT=medium

# Prices in US dollars per million tokens. They are used only to show what an import cost.
# Change them if the prices change.
# WRITER_PRICE_IN=2
# WRITER_PRICE_OUT=10

# How long to wait between web pages when reading a site, in milliseconds.
# 1000 is one page per second. Please keep it polite.
# FETCH_DELAY_MS=1000

# How often to check on a batch that is still with Claude, in seconds.
# BATCH_POLL_SECONDS=60

# ---------------------------------------------------------------------------
# The web app has one setting of its own. It goes in web/.env, not in this file.
# If you changed PORT above (for example to 4001), create web/.env containing:
#   VITE_API_URL=http://127.0.0.1:4001/
# ---------------------------------------------------------------------------
